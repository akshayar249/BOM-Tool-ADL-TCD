# PostgreSQL used by Docker Compose
POSTGRES_DB=info_sheets
POSTGRES_USER=info_user
POSTGRES_PASSWORD=change_this_password

# PostgreSQL exposed from Docker to the host -- see docker-compose.yml's
# postgres.ports mapping (host 5433 -> container 5432)
DATABASE_URL=postgresql+psycopg://info_user:change_this_password@localhost:5433/info_sheets

# Local persistent ChromaDB directory
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=special_instructions

# Downloaded automatically from Hugging Face on first Python run.
# This is NOT an Ollama model.
EMBED_MODEL=Alibaba-NLP/gte-large-en-v1.5
EMBED_DEVICE=cuda
EMBED_BATCH_SIZE=4

# Comma-separated origins allowed to call the backend/ FastAPI server
CORS_ORIGINS=http://localhost:3000

# Remote deployment / snapshot sync target
REMOTE_SSH_HOST=aiteam@172.25.0.5
REMOTE_PROJECT_DIR=/home/aiteam/ace-infosheet-search
REMOTE_SSH_PASS=change_this_remote_password
