# syntax=docker/dockerfile:1
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1

# Install curl for health monitoring, and gcc + libc6-dev for PyTorch/Triton CUDA JIT compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Install python packages with persistent BuildKit pip wheel cache
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

# Copy source code
COPY backend/ ./backend/
COPY search/ ./search/
COPY scripts/ ./scripts/

# Healthcheck checking the FastAPI /health endpoint
HEALTHCHECK --interval=10s --timeout=5s --start-period=180s --retries=5 \
    CMD curl -f http://localhost:8001/health || exit 1

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8001"]
